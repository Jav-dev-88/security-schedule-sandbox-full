/** Separate optional email relay. Set RELAY_TOKEN in Apps Script Properties.
 * Deploy as Web App: Execute as Me, access Anyone. Token required for every send.
 * Cloudflare secrets: MAIL_WEBHOOK_URL = deployment /exec URL; MAIL_RELAY_TOKEN = same token.
 */
function doPost(e){try{var data=JSON.parse(e.postData.contents||'{}');var token=PropertiesService.getScriptProperties().getProperty('RELAY_TOKEN');if(!token||data.token!==token)return reply_({ok:false,error:'Unauthorized'});if(!data.to||!data.pdfBase64)return reply_({ok:false,error:'Missing email or attachment'});var lock=LockService.getScriptLock();lock.waitLock(10000);try{var key='sent_'+data.requestId,props=PropertiesService.getScriptProperties();if(props.getProperty(key))return reply_({ok:true,duplicate:true});var attachment=Utilities.newBlob(Utilities.base64Decode(data.pdfBase64),'application/pdf',data.filename||'Schedule.pdf');MailApp.sendEmail({to:data.to,subject:data.subject||'Weekly Schedule',body:data.message||'Your weekly schedule is attached.',attachments:[attachment]});props.setProperty(key,String(Date.now()));var all=props.getProperties();Object.keys(all).forEach(function(k){if(k.indexOf('sent_')===0&&Number(all[k])<Date.now()-86400000)props.deleteProperty(k);});return reply_({ok:true});}finally{lock.releaseLock();}}catch(err){return reply_({ok:false,error:String(err.message||err)});}}
function reply_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
