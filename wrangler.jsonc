{
  "name": "security-schedule-sandbox-full",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "security-schedule-sandbox-full-db",
      "database_id": "9b127479-9c6f-4550-815b-02f5dba5d5c3",
      "migrations_dir": "migrations"
    }
  ]
}
